{
  "schemaVersion": 1,
  "id": "example-mod",
  "version": "${version}",
  "name": "Example Mod",
  "description": "A Minecraft mod.",
  "authors": [
    {
      "name": "Your Name"
    }
  ],
  "contact": {
    "homepage": "",
    "sources": ""
  },
  "license": "MIT",
  "icon": "assets/example-mod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.examplemod.fabric.ExampleModFabric"
    ],
    "client": [
      "com.example.examplemod.fabric.ExampleModClientFabric"
    ]
  },
  "mixins": [
    "example-mod.mixins.json",
    {
      "config": "example-mod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${fabric_minecraft_version}",
    "java": ">=${java_version}"
  }
}
